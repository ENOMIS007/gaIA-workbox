                size_hint: None, None
                width: 400
                height: 50
                on_release:
                    root.go_to_sign_in()


    
<SettingsWindow>:
    name: "settings"
    
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10
        
        BoxLayout:
            size_hint_y: None
            height: '40dp'
            orientation: 'horizontal'
                
            Widget:
                size_hint_x: 1 
                
            Button:
                text: "Home"
                size_hint_x: None
                width: '60dp'
                font_name: "Roboto"
                on_release: app.go_to_main()
                
        BoxLayout:
            orientation: "vertical"
            size: root.width, root.height
            
            Label:
                text: "Settings Screen"
                font_size: 32
                font_name: "Roboto"
                
            Label:
                id: logged_user_label
                text: "utente loggato"
                font_size: 21
                font_name: "Roboto"
            
            Button:
                text: "Logout"
                size_hint: None, None
                size: 200, 50
                pos_hint: {'center_x': 0.5}
                on_release:
                    root.logout()
            
