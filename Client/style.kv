WindowManager:
    LoginScreen:
    SignInScreen:
    MainWindow:
    ChatWindow:
    SettingsWindow:
    



<CustomButton>:
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    halign: 'left'
    valign: 'middle'
    font_name: "Roboto"
    shorten: True
    shorten_from: 'right'
    text_size: self.width - 25, self.height
    size_hint: None, None
    height: 50
    canvas.before:
        Color:
            rgba:
                (0, 0, 0, 1) if self.state == 'down' else \
                (60/255, 63/255, 65/255, 1) if self.active or self.hovering else \
                (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [18]



<HoverBox>:
    size_hint: None, None
    size: 250, 50


    CustomButton:
        id: main_hoverbox_button
        text: "Pulsante Principale"
        width: 210 if not self.hovering else 180
        text_size: self.width - 25, self.height
        pos: root.pos
        on_release:
            main_hoverbox_button.activate()
            root.function()
            
    Widget:
        size_hint: None, None
        size: 10, 50
        pos: 165, main_hoverbox_button.y
        canvas.before:
            Color:
                rgba: 60/255, 63/255, 65/255, 1 if main_hoverbox_button.hovering else 0
            Rectangle:
                pos: self.pos
                size: self.size
                
    Button:
        id: action_menu_button
        text: "[b]‧‧‧[/b]"
        font_size: 24
        font_name: "Roboto"
        markup: True
        size_hint: None, None
        size: 50, 50
        pos: 160, main_hoverbox_button.y
        background_normal: ''
        background_down: ''
        background_color: 0, 0, 0, 0
        color: 1, 1, 1, 1
        opacity: 1 if main_hoverbox_button.hovering else 0
        halign: 'center'
        valign: 'middle'
        text_size: self.size
        on_release: app.root.get_screen('chat').show_action_menu(action_menu_button)
        canvas.before:
            Color:
                rgba: 
                    (0, 0, 0, 1) if main_hoverbox_button.state == 'down' else \
                    (60/255, 63/255, 65/255, 1)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [18]



<Sidebar@BoxLayout>:
    orientation: 'vertical'
    size_hint: None, None
    width: 200
    height: root.parent.height if root.parent else 200  # Adatta l'altezza alla finestra
    padding: 10
    spacing: 10
    pos: root.parent.width, 0  # Posizionamento iniziale fuori dallo schermo (a destra)

    canvas.before:
        Color:
            rgba: 0.2, 0.2, 0.2, 1  # Grigio scuro
        Rectangle:
            pos: self.pos
            size: self.size

    Button:
        text: "Chat"
        size_hint_y: None
        height: '60dp'
        font_name: "Roboto"
        on_release: app.go_to_chat()
        
    Button:
        text: 'Vuoto!'
        size_hint_y: None
        height: '60dp'
        font_name: "Roboto"
        
#     Button:
#         text: 'Vuoto!'
#         size_hint_y: None
#         height: '60dp'
#         font_name: "Roboto"


    Widget:
        size_hint_y: 1
        
    Label:
        text: "[b]Made by:[/b]"
        size_hint_y: None
        height: '16dp'
        font_name: "Roboto"
        markup: True
        
    Label:
        text: "[b]Simone Longhitano[/b]"
        size_hint_y: None
        height: '14dp'
        font_name: "Roboto"
        markup: True
        
    Label:
        text: "[b]Pastone[/b]"
        size_hint_y: None
        height: '14dp'
        font_name: "Roboto"
        markup: True
        
    Widget:
        size_hint_y: None
        height: '4dp'
        
        
        
<ChatSidebar@BoxLayout>:
    orientation: 'vertical'
    size_hint: None, None
    width: 230
    height: root.parent.height if root.parent else 200  # Adatta l'altezza alla finestra
    padding: 10
    spacing: 10
    pos: -root.parent.width, 0  # Posizionamento iniziale fuori dallo schermo (a sinistra)

    canvas.before:
        Color:
            rgba: 0.2, 0.2, 0.2, 1  # Grigio scuro
        Rectangle:
            pos: self.pos
            size: self.size
            
    Button:
        text: "Home"
        size_hint_y: None
        height: '60dp'
        font_name: "Roboto"
        on_release: app.go_to_main()

    Button:
        text: "Nuova chat"
        size_hint_y: None
        height: '60dp'
        font_name: "Roboto"
        on_release: app.root.get_screen('chat').new_chat()


    ScrollView:
        size_hint_y: 1
        do_scroll_x: False

        BoxLayout:
            id: chat_buttons_container
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
        
#     Widget:
#         size_hint_y: 1



<IconButton>:
    source: ''
    background_color: (0, 0, 0, 0)
    background_normal: ''
    canvas.before:
        Color:
            rgba: root.background_rgba
        Ellipse:
            size: self.size
            pos: self.pos
    Image:
        id: user_icon
        source: root.source
        size: self.parent.size
        pos: self.parent.pos
        allow_stretch: True
        keep_ratio: True




<SignInScreen>:
    name: 'sign-in'
    FloatLayout:
    
        FloatLayout:
            size_hint: None, None
            size: 400, 40
            pos_hint: {'center_x': 0.5, 'top': 0.95}
            opacity: 0
            id: error_container

            canvas.before:
                Color:
                    rgba: 0.4, 0.2, 0.2, 1  # grigio-rosso
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10]

            BoxLayout:
                id: error_box
                orientation: 'horizontal'
                size: self.parent.size
                pos: self.parent.pos
                padding: 10
                spacing: 10

                Image:
                    source: '..\Immagini\error_icon.png'
                    size_hint_x: None
                    width: 30
                    allow_stretch: True
                    keep_ratio: True

                Label:
                    id: error_label
                    text: "Email e password sono obbligatori!"
                    font_size: '16sp'
                    color: 1, 1, 1, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
    
        BoxLayout:
            orientation: 'vertical'
            size_hint: None, None
            width: 400
            height: 360
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            spacing: 15

            Label:
                text: "Registrazione"
                font_size: '32sp'
                size_hint: None, None
                width: 400
                height: 80
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            TextInput:
                id: email
                hint_text: "Email"
                hint_text_color: (0.7, 0.7, 0.7, 1)
                background_color: (60 / 255, 63 / 255, 65 / 255, 1)
                cursor_color: (1, 1, 1, 1)
                foreground_color: (1, 1, 1, 1)
                multiline: False
                size_hint: None, None
                width: 400
                height: 40

            TextInput:
                id: password
                hint_text: "Password"
                hint_text_color: (0.7, 0.7, 0.7, 1)
                background_color: (60 / 255, 63 / 255, 65 / 255, 1)
                cursor_color: (1, 1, 1, 1)
                foreground_color: (1, 1, 1, 1)
                multiline: False
                password: True
                size_hint: None, None
                width: 400
                height: 40

            BoxLayout:
                orientation: 'horizontal'
                size_hint: None, None
                width: 400
                height: 30
                spacing: 5

                CheckBox:
                    id: show_password_cb
                    on_active: password.password = not self.active
                    size_hint: None, None
                    width: 30
                    height: 30

                Label:
                    text: "Mostra password"
                    font_size: '16sp'
                    size_hint: None, None
                    width: 260
                    height: 30
                    valign: 'middle'
                    halign: 'left'
                    text_size: self.size

            BoxLayout:
                orientation: 'horizontal'
                size_hint: None, None
                width: 400
                height: 30
                spacing: 5

                CheckBox:
                    id: keep_logged_cb
                    size_hint: None, None
                    width: 30
                    height: 30

                Label:
                    text: "Mantieni l'accesso"
                    font_size: '16sp'
                    size_hint: None, None
                    width: 260
                    height: 30
                    valign: 'middle'
                    halign: 'left'
                    text_size: self.size

            Button:
                text: "Invia"
                size_hint: None, None
                width: 400
                height: 50
                on_release:
                    root.do_sign_in()
                    
            Widget:
                size_hint: None, None
                width: 400
                height: 50




