<MainWindow>:
    name: "main"
    
    
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10     

        BoxLayout:
            orientation: "vertical"
            size: root.width, root.height
            
            Widget:
                size_hint_y: 1
            
            Label:
                text: "[b]Main Screen[/b]"
                font_size: 32
                size_hint_y: None
                font_name: "Roboto"
                markup: True
                
            Widget:  
                size_hint_y: None
                height: '260dp'
                
            Label:
                id: user_request_label
                text: 
                font_size: 16
                size_hint_y: None
                height: '40dp'
                font_name: "Roboto"
                
            Widget:
                size_hint_y: 1
                
            Widget:
                size_hint_y: None
                height: '40dp'
                
                
    FloatLayout:
    
        IconButton:
            source: '../Immagini/test.png'
            size_hint: None, None
            size: 50, 50
            pos: 10, self.parent.height - self.height - 10
            on_release: app.go_to_settings()

        Sidebar:
            id: sidebar
            opacity: 0  # Nasconde il menu inizialmente

        Button:
            id: menu_button
            text: '[b]|||[/b]'
            font_name: "Roboto"
            markup: True
            size_hint: None, None
            size: 80, 40
            pos: self.parent.width - self.width - 10, self.parent.height - self.height - 10  # Posizionato in alto a destra
            on_release: root.toggle_sidebar()
                
                    
                
<ChatWindow>:
    name: "chat"
    
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10

        ScrollView:
            size_hint_x: 1
            size_hint_y: None
            height: root.height - user_input.height - 110
            bar_width: 4
            scroll_type: ['bars', 'content']
            bar_color: (1, 1, 1, 1)
            bar_inactive_color: (0.7, 0.7, 0.7, 0.5)

            BoxLayout:
                id: chat_window
                size_hint_y: None
                orientation: 'vertical'
                spacing: 40
                height: self.minimum_height

        BoxLayout:
            size_hint_y: None
            height: user_input.height + 10
            orientation: 'horizontal'
            spacing: 10

            CustomTextInput:
                id: user_input
                app: app
                size_hint_x: 1
                size_hint_y: None
                height: self.minimum_height
                multiline: True
                font_name: "Roboto"
                hint_text: "Scrivi un messaggio a gaIA"
                hint_text_color: (0.7, 0.7, 0.7, 1)
                background_color: (0, 0, 0, 0)
                cursor_color: (1, 1, 1, 1)
                foreground_color: (1, 1, 1, 1)
                padding: [10, 10]
                
                
            BoxLayout:
                orientation: 'vertical'
                size_hint: None, None
                size: 40, 50

                IconButton:
                    source: '../Immagini/send_icon.png'
                    size_hint: None, None
                    size: 40, 40
                    on_release: root.send_message()
                    
                Widget:
                    size_hint_y: None
                    height: 0.1
                
                Widget:
                    size_hint_x: None
                    width: 0.1
                    
                    
            Widget:
                size_hint_x: None
                width: 0.1

                

    FloatLayout:
        id: float_layout
        
        FloatLayout:
            size_hint_y: None
            height: 90  # Altezza fissa come l'immagine
            pos_hint: {'top': 1}

            Image:
                source: '../Immagini/chat_name_box.png'
                allow_stretch: True
                keep_ratio: False
                size_hint: 1, 1
                pos_hint: {'top': 1}

            Label:
                id: chat_name
                text: ""
                bold: True
                font_size: 22
                size_hint: None, None
                size: self.texture_size
                pos_hint: {'center_x': 0.5, 'center_y': 0.65}
                font_name: "Roboto"
                color: 1, 1, 1, 1  # Bianco, modifica se necessario


        # Sidebar sovrapposta
        Sidebar:
            id: sidebar
            opacity: 0  # Nasconde il menu inizialmente
            
        ChatSidebar:
            id: chat_sidebar
            opacity: 0  # Nasconde il menu inizialmente
            

        # Pulsante Menu posizionato assolutamente
        Button:
            id: menu_button
            text: '[b]|||[/b]'
            font_name: "Roboto"
            markup: True
            size_hint: None, None
            size: 80, 40
            pos: self.parent.width - self.width - 10, self.parent.height - self.height - 10  # Posizionato in alto a destra
            on_release: root.toggle_sidebar()
            
        IconButton:
            id: user_button
            source: '../Immagini/test.png'
            size_hint: None, None
            size: 50, 50
            pos: 10, self.parent.height - self.height - 10 # Posizionato in alto a sinistra
            on_release: root.toggle_chat_sidebar()
          
            
        Widget:
            id: overlay
            canvas:
                Color:
                    rgba: 0, 0, 0, 0.7
                Rectangle:
                    pos: self.pos
                    size: self.size
            size: self.parent.size
            pos: self.parent.pos
            opacity: 0
            on_touch_down: root.on_overlay_touch_down(args[1]) or False # intercetta i touch per chiudere il menu

        BoxLayout:
            id: action_box
            orientation: 'vertical'
            size_hint: None, None
            size: 160, 170
            pos: 0, 0  # posizione aggiornata dinamicamente in Python
            opacity: 0
            disabled: True
            spacing: 5
            padding: 5
            canvas.before:
                Color:
                    rgba: 0.2, 0.2, 0.2, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10]

            CustomButton:
                text: "[b]Modifica[/b]"
                font_name: "Roboto"
                markup: True
                width: 150
                on_release: root.on_action_button('modifica')

            CustomButton:
                text: "[b]Bho[/b]"
                font_name: "Roboto"
                markup: True
                width: 150
                on_release: root.on_action_button('bho')

            CustomButton:
                text: "[b]Elimina[/b]"
                font_name: "Roboto"
                markup: True
                width: 150
                on_release: root.on_action_button('elimina')

        Label:
            id: input_label
            text: " [b]Nome chat:[/b]"
            font_name: "Roboto"
            markup: True
            size_hint: None, None
            size: self.texture_size
            pos: chat_name_input.x, chat_name_input.top + 5
            color: 1, 1, 1, 1
            opacity: 0
            disabled: True
            canvas.before:
                Color:
                    rgba: 0.06, 0.06, 0.06, 1 
                Rectangle:
                    pos: self.x, self.y - 3
                    size: self.width + 130, self.height + 15

        TextInput:
            id: chat_name_input
            hint_text: "Nome"
            font_name: "Roboto"
            multiline: False
            size_hint: None, None
            background_color: (60 / 255, 63 / 255, 65 / 255, 1)
            cursor_color: (1, 1, 1, 1)
            foreground_color: (1, 1, 1, 1)
            opacity: 0
            disabled: True
            on_text_validate: root.change_chat_name(self)

                
